{
  "name": "@randomcontrol/webex-viewer",
  "version": "2.0.0",
  "description": "Maverick WebEx viewer browser SDK",
  "type": "module",
  "main": "./webex-viewer.mjs",
  "module": "./webex-viewer.mjs",
  "types": "./webex-viewer.d.ts",
  "exports": {
    ".": {
      "types": "./webex-viewer.d.ts",
      "import": "./webex-viewer.mjs",
      "default": "./webex-viewer.mjs"
    },
    "./classic": {
      "default": "./webex-viewer.js"
    }
  },
  "files": [
    "webex-viewer.js",
    "webex-viewer.mjs",
    "webex-viewer.d.ts",
    "webex-viewer-engine.js",
    "webex-viewer-engine.wasm",
    "webex-viewer-engine.data"
  ],
  "sideEffects": false,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randomcontrol/webex-viewer.git"
  },
  "homepage": "https://github.com/randomcontrol/webex-viewer#readme",
  "bugs": "https://github.com/randomcontrol/webex-viewer/issues",
  "keywords": [
    "maverick",
    "webex",
    "webgl",
    "webgpu",
    "3d-viewer"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
